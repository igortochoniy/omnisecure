# Copy to .env and fill in. .env is gitignored.

# TinaCloud (production CMS editing). Leave BOTH empty for local editing
# (`pnpm cms` writes straight to files). Get these from app.tina.io after
# creating a project for this repo.
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=

# Resend contact form (Cloudflare Pages env in production; local only if you
# test the Function locally). CONTACT_FROM must be on a Resend-verified domain.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Optional form hardening / reliability (skipped when empty):
#  TURNSTILE_SECRET — Cloudflare Turnstile secret key (spam). Also add the
#                     widget + site key to the form (see AI_GUIDE).
#  ALERT_WEBHOOK    — Slack/Telegram/etc. webhook; pinged if a send fails so a
#                     lead is never lost silently.
TURNSTILE_SECRET=
ALERT_WEBHOOK=
