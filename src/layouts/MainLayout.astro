---
// Full-bleed layout for the Omnisecure one-pager. Keeps the studio SEO/perf
// shell (Meta, lazy interaction JS, analytics) but drops the ScrewFast container
// + Navbar/Footer in favour of the design's own Header/Footer, and forces a
// single fixed (light) theme — no dark toggle.
import Meta from '@components/Meta.astro';
import Header from '@components/sections/Header.astro';
import Footer from '@components/sections/Footer.astro';
import { SITE, CONTACT } from '@data/constants';
import '@fontsource-variable/manrope';
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '@styles/global.css';

const {
  title = SITE.title,
  meta,
  structuredData,
  lang = 'en',
  customDescription = null,
  customOgTitle = null,
  noindex = false,
  headerSolid = false,
} = Astro.props;

interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
  noindex?: boolean;
  headerSolid?: boolean;
}
---

<html lang={lang} class="lenis lenis-smooth scroll-smooth">
  <head>
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
      noindex={noindex}
    />
    <title>{title}</title>
    {/* Mark JS active before paint so scroll-reveal starts hidden only with JS
      (no-JS users still see all content). */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Preload the primary font (kept in sync with the Fontsource @font-face). */}
    <link
      rel="preload"
      href={manropeWoff2}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {
      /* Conversion tracking loads eagerly (tiny, no deps) so the first tel: click
        is never missed. */
    }
    <script>
      import '@scripts/analytics';
    </script>
    {
      /* Lazy-load interaction JS OFF the critical path: boot on idle or first
        interaction, whichever comes first (PageSpeed playbook). */
    }
    <script>
      let started = false;
      const events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
      const boot = () => {
        if (started) return;
        started = true;
        events.forEach(e => window.removeEventListener(e, boot));
        import('@scripts/lenisSmoothScroll.js');
        import('@scripts/reveals');
        import('@scripts/reviews');
        import('@scripts/contact-form');
      };
      events.forEach(e => window.addEventListener(e, boot, { passive: true }));
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(boot, { timeout: 2000 });
      } else {
        window.addEventListener('load', () => setTimeout(boot, 200));
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <Header solid={headerSolid} />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    {
      /* Mobile-only floating call button — hidden until the hero scrolls out of
        view, then fades in bottom-right. Only on the one-pager (a hero exists). */
      !headerSolid && (
        <a
          href={CONTACT.phoneHref}
          class="ms-callfab"
          data-track="call_click"
          aria-label={`Call now at ${CONTACT.phoneDisplay}`}
        >
          <svg
            viewBox="0 0 24 24"
            width="21"
            height="21"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z" />
          </svg>
        </a>
      )
    }
    <style is:global>
      .ms-callfab {
        position: fixed;
        left: 25px;
        bottom: 25px;
        z-index: 60;
        display: none;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #2b57f0;
        box-shadow:
          0 14px 32px rgba(43, 87, 240, 0.5),
          0 4px 10px rgba(10, 16, 40, 0.25);
        opacity: 0;
        transform: translateY(18px) scale(0.85);
        transition:
          opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .ms-callfab::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #2b57f0;
        opacity: 0.55;
        animation: msFabPing 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
        z-index: -1;
      }
      .ms-callfab.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      @keyframes msFabPing {
        0% {
          transform: scale(1);
          opacity: 0.5;
        }
        70%,
        100% {
          transform: scale(1.7);
          opacity: 0;
        }
      }
      @media (max-width: 43.75rem) {
        .ms-callfab {
          display: flex;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .ms-callfab::before {
          animation: none;
        }
      }
    </style>
    {!headerSolid && (
      <script is:inline define:vars={{ heroId: 'top' }}>
        (function () {
          var fab = document.querySelector('.ms-callfab');
          var hero = document.getElementById(heroId);
          if (!fab || !hero) return;
          // IntersectionObserver tracks the hero's real viewport position, so it
          // works under Lenis (which drives scroll without firing reliable window
          // scroll events). Fallback to a scroll listener if IO is unavailable.
          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(
              function (entries) {
                fab.classList.toggle('is-visible', !entries[0].isIntersecting);
              },
              { rootMargin: '-40px 0px 0px 0px', threshold: 0 }
            );
            io.observe(hero);
          } else {
            var toggle = function () {
              fab.classList.toggle('is-visible', hero.getBoundingClientRect().bottom < 40);
            };
            toggle();
            window.addEventListener('scroll', toggle, { passive: true });
          }
        })();
      </script>
    )}
  </body>
</html>
