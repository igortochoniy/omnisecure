---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, CONTACT } from '@data/constants';

// TODO: have the client / their legal advisor review this template before launch.
const updated = 'July 2026';
---

<MainLayout
  title={`Privacy Policy | ${SITE.title}`}
  customDescription="How Omnisecure Locksmith LLC collects, uses and protects the information you share when you contact us."
  headerSolid={true}
  noindex={true}
>
  <article class="ms-legal">
    <div class="mx-auto w-full max-w-[820px] px-6">
      <Breadcrumbs
        items={[{ name: 'Home', href: '/' }, { name: 'Privacy Policy' }]}
      />
      <h1 class="ms-legal-h1">Privacy Policy</h1>
      <p class="ms-legal-meta">Last updated: {updated}</p>

      <p>
        This Privacy Policy explains how {SITE.title} ("we", "us") handles the
        information you provide when you request a callback, call us, or
        otherwise contact us about our locksmith services.
      </p>

      <h2>Information we collect</h2>
      <p>
        When you submit a callback request we collect the details you enter —
        typically your name, phone number, the service you need and any message.
        If you call us, we may keep a record of your number and the nature of
        your request.
      </p>

      <h2>How we use your information</h2>
      <p>
        We use your details only to respond to your enquiry, schedule and carry
        out the work you asked for, and follow up about that job. We do not sell
        your information.
      </p>

      <h2>How we share it</h2>
      <p>
        We share your information only with the service providers that help us
        run the business (for example, the tool that delivers your callback
        request to our inbox) and where required by law.
      </p>

      <h2>Data retention</h2>
      <p>
        We keep enquiry records only as long as needed to serve you and to meet
        our legal and accounting obligations, then delete them.
      </p>

      <h2>Your choices</h2>
      <p>
        You can ask us to access, correct or delete the information we hold about
        you at any time by contacting us at
        <a href={CONTACT.emailHref}>{CONTACT.email}</a> or
        <a href={CONTACT.phoneHref} data-track="call_click">{CONTACT.phoneDisplay}</a
        >.
      </p>

      <h2>Contact us</h2>
      <p>
        {SITE.title} — {CONTACT.areaLong}.<br />
        Phone: <a href={CONTACT.phoneHref} data-track="call_click">{CONTACT.phoneDisplay}</a
        > · Email: <a href={CONTACT.emailHref}>{CONTACT.email}</a>
      </p>
    </div>
  </article>
</MainLayout>

<style>
  .ms-legal {
    padding: 56px 0 96px;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .ms-legal-h1 {
    margin-top: 20px;
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -1.4px;
    color: var(--color-ink);
  }
  .ms-legal-meta {
    margin-top: 8px;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .ms-legal h2 {
    margin-top: 34px;
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 800;
    color: var(--color-ink);
  }
  .ms-legal p {
    margin-bottom: 14px;
  }
  .ms-legal a {
    color: var(--color-brand);
    font-weight: 600;
  }
  @media (max-width: 43.75rem) {
    .ms-legal-h1 {
      font-size: 32px;
    }
  }
</style>
