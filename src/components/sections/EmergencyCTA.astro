---
// Emergency CTA band — transcribed 1:1 from the design. White section, navy card
// with a coral glow (top-left) + blue glow (bottom-right), a live "Available
// 24/7" pill, and two stacked CTAs (blue Call / white Request Callback).
import { CONTACT } from '@data/constants';
---

<section class="ms-emg-sec">
  <div class="ms-emg-card reveal">
    <div class="ms-emg-glow ms-emg-glow1" aria-hidden="true"></div>
    <div class="ms-emg-glow ms-emg-glow2" aria-hidden="true"></div>
    <div class="ms-emg-band">
      <div class="ms-emg-left">
        <span class="ms-emg-pill">
          <span class="ms-emg-dot"></span>
          Available 24/7
        </span>
        <h2 class="ms-emg-h2">Locked out right now?</h2>
        <p class="ms-emg-lead">
          Don't wait in the cold. Call and a licensed locksmith is on the way —
          typically within 20–30 minutes.
        </p>
      </div>
      <div class="ms-emg-btns">
        <a
          href={CONTACT.phoneHref}
          class="ms-cta ms-cta-blue"
          data-track="call_click"
          aria-label={`Call now at ${CONTACT.phoneDisplay}`}
        >
          <svg
            class="ms-cta-ico"
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"
            ></path>
          </svg>
          Call Now
        </a>
        <a href="#request-callback" class="ms-cta ms-cta-white">
          <svg
            class="ms-cta-ico"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="#0f1633"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            ></path>
          </svg>
          Request Callback
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ms-emg-sec {
    background: #fff;
    padding: 0 15px;
  }
  .ms-emg-card {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
    background: #0f1734;
    border-radius: 30px;
    padding: 52px 48px;
  }
  .ms-emg-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .ms-emg-glow1 {
    top: -140px;
    left: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 122, 110, 0.32), transparent 70%);
  }
  .ms-emg-glow2 {
    bottom: -260px;
    right: -140px;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, rgba(43, 87, 240, 0.55), transparent 70%);
  }
  .ms-emg-band {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .ms-emg-left {
    max-width: 620px;
  }
  .ms-emg-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(217, 58, 47, 0.18);
    color: #ff8a7e;
    font-weight: 700;
    font-size: 12.5px;
    padding: 6px 13px;
    border-radius: 999px;
    letter-spacing: 0.3px;
  }
  .ms-emg-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff6a5a;
    box-shadow: 0 0 0 4px rgba(255, 106, 90, 0.22);
    flex: none;
  }
  .ms-emg-h2 {
    font-size: 38px;
    line-height: 1.08;
    letter-spacing: -1px;
    font-weight: 800;
    margin: 16px 0 0;
    color: #fff;
  }
  .ms-emg-lead {
    font-size: 17px;
    line-height: 1.6;
    color: #b6bdd6;
    margin: 14px 0 0;
  }

  /* Buttons — inline row, same as the Pricing CTA row (global .ms-cta sizing). */
  .ms-emg-btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  @media (max-width: 43.75rem) {
    .ms-emg-sec {
      padding: 20px 10px;
    }
    .ms-emg-card {
      padding: 60px 20px;
    }
    .ms-emg-btns {
      width: 100%;
    }
    .ms-emg-btns > a {
      flex: 1 1 auto;
      justify-content: center;
      padding: 14px 18px;
      font-size: 16px;
    }
  }
</style>
