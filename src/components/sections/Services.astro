---
// Services (design handoff §4.3) — offwhite section, 2×2 card grid.
import ServiceCard from '@components/sections/ServiceCard.astro';
import imgEmergency from '@images/design/svc-emergency.webp'; // real design photos
import imgResidential from '@images/design/svc-residential.webp';
import imgAutomotive from '@images/design/svc-automotive.webp';
import imgCommercial from '@images/design/svc-commercial.webp';

const cards = [
  {
    id: 'svc-emergency',
    title: 'Emergency Locksmith',
    copy: 'Locked out of your home, car or office? We respond fast and get you back in, no damage, no drama.',
    image: imgEmergency,
    alt: 'Locksmith unlocking a residential deadbolt during an emergency lockout',
  },
  {
    id: 'svc-residential',
    title: 'Residential Locksmith',
    copy: 'Lock changes, re-keys, deadbolt installs and smart locks to keep your family and home secure.',
    image: imgResidential,
    alt: 'Technician installing a residential deadbolt lock',
  },
  {
    id: 'svc-automotive',
    title: 'Automotive Locksmith',
    copy: 'Car lockouts, transponder and key-fob programming, ignition and broken-key removal for most makes and models.',
    image: imgAutomotive,
    alt: 'Driver locked out of a car, waiting for an automotive locksmith',
  },
  {
    id: 'svc-commercial',
    title: 'Commercial Locksmith',
    copy: 'Master-key systems, high-security locks, panic bars and access control to protect your business and staff.',
    image: imgCommercial,
    alt: 'Commercial high-security lock and access control system',
  },
];
---

<section id="services" class="ms-svc-sec">
  <div class="ms-svc-inner mx-auto w-full max-w-[1140px] px-6">
    <div class="reveal mx-auto max-w-[720px] text-center">
      <p class="ms-kicker">Our Services</p>
      <h2 class="ms-h2">
        Everything you lock. <br class="max-xs:hidden" />One team you trust.
      </h2>
      <p class="ms-lead">
        Whether it's an urgent lockout or a full commercial master-key
        system, you get fast, clean work from an insured local team.
      </p>

      <div class="ms-svc-stats">
        <div class="ms-svc-stat">
          <span class="ms-svc-stat-ico">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#2b57f0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 12l2 2 4-4"></path>
              <path d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7z"></path>
            </svg>
          </span>
          <span class="ms-svc-stat-txt">
            <span class="ms-svc-stat-t">Insured</span>
            <span class="ms-svc-stat-s">Professional services.</span>
          </span>
        </div>
        <div class="ms-svc-stat">
          <span class="ms-svc-stat-ico">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#2b57f0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2L4.5 13H11l-1 9 8.5-11H12z"></path>
            </svg>
          </span>
          <span class="ms-svc-stat-txt">
            <span class="ms-svc-stat-t">Same-day</span>
            <span class="ms-svc-stat-s">Most jobs on arrival</span>
          </span>
        </div>
      </div>
    </div>

    <div class="mt-[68px] grid gap-6 nav:grid-cols-2">
      {cards.map((c, i) => <ServiceCard {...c} revealDelay={i * 90} />)}
    </div>
  </div>
</section>

<style>
  .ms-svc-sec {
    position: relative;
    background: #f5f6fb;
    overflow: hidden;
    scroll-margin-top: 0;
  }

  /* Trust stat pills (moved from the hero) — light-section styling, centered,
     equal width. */
  .ms-svc-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 30px auto 0;
  }
  .ms-svc-stat {
    min-width: 210px;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: #ffffff;
    border: 1px solid #e5e8f2;
    border-radius: 999px;
    padding: 10px 20px 10px 12px;
    box-shadow: 0 6px 18px rgba(16, 24, 50, 0.06);
  }
  @media (max-width: 43.75rem) {
    .ms-svc-stats {
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 8px;
      max-width: 100%;
    }
    /* Mobile: two pills in one row, equal width. */
    .ms-svc-stat {
      flex: 1 1 0;
      min-width: 0;
      gap: 8px;
      padding: 9px 10px;
    }
    .ms-svc-stat-ico {
      width: 30px;
      height: 30px;
    }
    .ms-svc-stat-t {
      font-size: 13.5px;
    }
    .ms-svc-stat-s {
      font-size: 11px;
    }
  }
  .ms-svc-stat-ico {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #eaf0ff;
    border: 1px solid #d4e0ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ms-svc-stat-txt {
    line-height: 1.15;
    text-align: left;
  }
  .ms-svc-stat-t {
    display: block;
    font-weight: 800;
    font-size: 15px;
    color: #0c1023;
  }
  .ms-svc-stat-s {
    display: block;
    font-size: 12.5px;
    color: #6b6f7d;
    margin-top: 3px;
  }
  .ms-svc-inner {
    position: relative;
    padding: 108px 15px;
  }
  .ms-svc-sec::before,
  .ms-svc-sec::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .ms-svc-sec::before {
    top: -120px;
    left: -140px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(43, 87, 240, 0.05), transparent 72%);
  }
  .ms-svc-sec::after {
    bottom: -160px;
    right: -120px;
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, rgba(43, 87, 240, 0.04), transparent 72%);
  }
  @media (max-width: 43.75rem) {
    .ms-svc-inner {
      padding: 64px 10px;
    }
  }
</style>
