---
// One service card (design handoff §4.3): centered title + one-line copy +
// "Learn more" link, with a 16:11.4 photo anchored at the card bottom.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  copy: string;
  image: ImageMetadata;
  alt: string;
  href?: string;
  id?: string;
  revealDelay?: number;
}
const { title, copy, image, alt, href = '#request-callback', id, revealDelay } = Astro.props;
---

<a
  href={href}
  class="ms-svc-card reveal group block"
  data-reveal-delay={revealDelay}
>
  {/* Anchor target on a non-focusable element so footer #svc-* links scroll here
      without focus-highlighting the whole card. */}
  <div class="ms-svc-body" id={id}>
    <h3 class="ms-svc-title">{title}</h3>
    <p class="ms-svc-copy">{copy}</p>
    <span class="ms-svc-link">
      Learn more
      <svg
        viewBox="0 0 24 24"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
  <div class="ms-svc-imgwrap">
    <Image
      src={image}
      alt={alt}
      width={720}
      loading="lazy"
      decoding="async"
      class="ms-svc-img"
    />
  </div>
</a>

<style>
  .ms-svc-card {
    scroll-margin-top: 100px;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #ebedf3;
    border-radius: 24px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(16, 24, 50, 0.04),
      0 10px 30px rgba(16, 24, 50, 0.05);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ms-svc-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 34px 70px rgba(18, 24, 50, 0.16);
  }
  .ms-svc-body {
    scroll-margin-top: 100px;
    padding: 46px 42px 30px;
    text-align: center;
  }
  .ms-svc-title {
    color: #0c1023;
    font-size: 27px;
    font-weight: 800;
    letter-spacing: -0.7px;
  }
  .ms-svc-copy {
    margin: 11px auto 0;
    max-width: 32ch;
    color: #6b6f7d;
    font-size: 16px;
    line-height: 1.55;
  }
  .ms-svc-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    color: var(--color-brand);
    font-size: 15px;
    font-weight: 600;
    transition: gap 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ms-svc-link svg {
    width: 15px;
    height: 15px;
  }
  .ms-svc-card:hover .ms-svc-link {
    gap: 11px;
  }
  .ms-svc-imgwrap {
    margin-top: auto;
    overflow: hidden;
  }
  .ms-svc-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11.4;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .ms-svc-card:hover {
      transform: none;
    }
  }
</style>
