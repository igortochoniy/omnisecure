---
// Pricing (design handoff §4.4) — white section wrapping a dark navy panel with
// glass fee badges, a 4-up price-card grid, and a CTA row.
import PriceCard from '@components/sections/PriceCard.astro';
import { CONTACT } from '@data/constants';

const cards = [
  {
    title: ['Emergency', 'Locksmith'] as [string, string],
    price: '95',
    note: 'Round-the-clock lockout response.',
    accent: 'coral' as const,
    icon: 'bolt' as const,
  },
  {
    title: ['Car', 'Locksmith'] as [string, string],
    price: '95',
    note: 'Vehicle unlock & key service.',
    icon: 'car' as const,
  },
  {
    title: ['Lock', 'Change'] as [string, string],
    price: '75',
    note: 'Swap out worn or old locks.',
    icon: 'lock' as const,
  },
  {
    title: ['Re-key', 'Service'] as [string, string],
    price: '75',
    note: 'Keep the lock, change the key.',
    icon: 'key' as const,
  },
];
---

<section id="pricing" class="ms-price-sec">
  <div class="ms-price-outer mx-auto w-full max-w-[1200px]">
    <div class="ms-price-panel">
      {/* Glow orbs as real divs (like the design) so the price-card
        backdrop-filter picks them up — a z-indexed pseudo-element would not. */}
      <div class="ms-price-glow ms-price-glow1" aria-hidden="true"></div>
      <div class="ms-price-glow ms-price-glow2" aria-hidden="true"></div>
      <div class="ms-price-inner">
      <div class="ms-price-head reveal max-w-[720px]">
        <p class="ms-kicker ms-kicker-light">Pricing</p>
        <h2 class="ms-h2 ms-h2-pricing">Clear pricing, zero surprises</h2>
        <p class="ms-lead ms-lead-pricing">
          Honest, upfront rates with no hidden charges. Every job starts with a
          clear, itemized quote, so you'll always know exactly what you're
          paying before we begin.
        </p>

        {/* Fee badges (inside the 720px head, like the design) */}
        <div class="ms-price-badges">
          <div class="ms-badge">
            <span class="ms-badge-fee">
              <span class="ms-badge-cur">$</span><span class="ms-badge-num">65</span
              >
            </span>
            <div class="ms-badge-txt">
              <strong>Flat service-call fee</strong>
              <span>Covers travel anywhere we serve</span>
            </div>
          </div>
          <div class="ms-badge">
            <span class="ms-badge-check" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="#1f9d55"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </span>
            <div class="ms-badge-txt">
              <strong>Upfront pricing</strong>
              <span>No hidden fees, ever</span>
            </div>
          </div>
        </div>
      </div>

      {/* No reveal on the card grid: the cards are backdrop-filter glass over a
        sibling glow, so a reveal transform would cut the glow mid-animation and
        pop it back in at the end. They stay put (always glowing) while the rest
        of the panel fades up. */}
      <div class="ms-price-grid">
        {cards.map(c => <PriceCard {...c} />)}
      </div>

      {/* CTA row */}
      <div class="ms-btn-row reveal">
        <a
          href={CONTACT.phoneHref}
          class="ms-cta ms-cta-blue"
          data-track="call_click"
          aria-label={`Call now at ${CONTACT.phoneDisplay}`}
        >
          <svg
            class="ms-cta-ico"
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"
            ></path>
          </svg>
          Call Now
        </a>
        <a href="#request-callback" class="ms-cta ms-cta-white">
          <svg
            class="ms-cta-ico"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="#0f1633"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            ></path>
          </svg>
          Request Callback
        </a>
      </div>
      <p class="ms-final-quote reveal">
        Final quote confirmed on site before any work begins.
      </p>
      </div>
    </div>
  </div>
</section>

<style>
  .ms-price-sec {
    background: #fff;
    scroll-margin-top: 0;
  }
  .ms-price-outer {
    padding: 108px 15px;
  }
  .ms-price-panel {
    position: relative;
    overflow: hidden;
    border-radius: 30px;
    padding: 76px 64px;
    background: #0f1734;
  }
  .ms-price-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .ms-price-glow1 {
    width: 1600px;
    height: 1600px;
    top: -400px;
    right: -300px;
    background: radial-gradient(circle, rgba(43, 87, 240, 0.55), transparent 70%);
  }
  .ms-price-glow2 {
    width: 1100px;
    height: 1100px;
    bottom: -300px;
    left: -220px;
    background: radial-gradient(circle, rgba(169, 190, 255, 0.42), transparent 68%);
  }
  /* No z-index here — matches the design so the cards' backdrop-filter samples
     the glows (a stacking context on the content would exclude them). */
  .ms-price-inner {
    position: relative;
  }
  .ms-kicker-light {
    color: #7ea0ff;
  }
  .ms-h2-pricing {
    color: #fff;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -1px;
  }
  .ms-lead-pricing {
    color: #b6bdd6;
    font-size: 17px;
    line-height: 1.6;
    max-width: 700px;
  }

  .ms-price-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .ms-badge {
    flex: 1 1 260px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border-radius: 16px;
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.92),
      rgba(255, 255, 255, 0.78)
    );
    border: 1px solid rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(14px) saturate(150%);
    box-shadow:
      0 10px 26px rgba(6, 10, 28, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 0.8);
  }
  .ms-badge-fee {
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    gap: 1px;
    width: 46px;
    flex: none;
    color: #1f9d55;
  }
  .ms-badge-cur {
    font-size: 20px;
    font-weight: 800;
    margin-top: 4px;
  }
  .ms-badge-num {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1;
  }
  .ms-badge-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 42px;
    border-radius: 12px;
    background: rgba(31, 157, 85, 0.14);
    border: 1px solid rgba(31, 157, 85, 0.28);
    flex: none;
  }
  .ms-badge-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .ms-badge-txt strong {
    color: #0c1023;
    font-size: 15px;
    font-weight: 800;
  }
  .ms-badge-txt span {
    color: #6b6f7d;
    font-size: 13px;
  }

  .ms-price-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 56px;
  }
  .ms-btn-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 44px;
  }
  .ms-final-quote {
    color: #8f97b6;
    font-size: 13.5px;
    margin-top: 18px;
  }

  @media (max-width: 56.25rem) {
    .ms-price-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 43.75rem) {
    .ms-price-outer {
      padding: 64px 10px;
    }
    .ms-price-panel {
      padding: 60px 10px;
    }
    .ms-price-grid {
      gap: 5px;
    }
    .ms-price-head {
      text-align: center;
      margin: 0 auto;
    }
    .ms-price-badges {
      justify-content: flex-start;
      text-align: left;
    }
    .ms-final-quote {
      text-align: center;
    }
    .ms-btn-row > a {
      flex: 1 1 auto;
      justify-content: center;
      padding: 14px 18px;
      font-size: 16px;
    }
  }
</style>
