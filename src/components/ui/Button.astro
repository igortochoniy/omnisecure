---
// Shared CTA button (design handoff §3). Variants:
//   blue  — primary, bg-brand + blue glow shadow
//   white — secondary, white surface + soft shadow
// Both get a skewed shine sweep on hover and the leading icon rotates slightly.
// Motion is disabled under prefers-reduced-motion by the global reset.
interface Props {
  variant?: 'blue' | 'white';
  href: string;
  icon?: 'phone' | 'callback' | 'arrow' | 'none';
  size?: 'md' | 'sm';
  class?: string;
  ariaLabel?: string;
  dataTrack?: string;
}
const {
  variant = 'blue',
  href,
  icon = 'phone',
  size = 'md',
  class: className = '',
  ariaLabel,
  dataTrack,
} = Astro.props;

const icons: Record<string, string> = {
  phone:
    '<path d="M6.62 10.79a15.5 15.5 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/>',
  callback:
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z"/>',
  arrow:
    '<path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>',
  none: '',
};

const pad = size === 'sm' ? 'px-5 py-3 text-[15px]' : 'px-7 py-4 text-base';
const base =
  'ms-cta group relative inline-flex items-center justify-center gap-2.5 rounded-[14px] font-bold no-underline transition';
const skin =
  variant === 'blue'
    ? 'ms-cta-blue bg-brand text-white'
    : 'ms-cta-white bg-white text-[#0f1633]';
---

<a
  href={href}
  class:list={[base, skin, pad, className]}
  aria-label={ariaLabel}
  data-track={dataTrack}
>
  {
    icon !== 'none' && (
      <svg
        class="ms-cta-ico h-[1.15em] w-[1.15em] shrink-0"
        viewBox="0 0 24 24"
        fill={icon === 'arrow' ? 'none' : 'currentColor'}
        aria-hidden="true"
        set:html={icons[icon]}
      />
    )
  }
  <span><slot /></span>
</a>

<style>
  .ms-cta {
    position: relative;
    overflow: hidden;
    will-change: transform;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.3s ease;
  }
  .ms-cta > * {
    position: relative;
    z-index: 1;
  }
  .ms-cta::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 45%;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(255, 255, 255, 0.55),
      transparent
    );
    transform: skewX(-18deg);
    transition: left 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 0;
    pointer-events: none;
  }
  .ms-cta:hover::before {
    left: 130%;
  }
  .ms-cta-ico {
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ms-cta:hover .ms-cta-ico {
    transform: rotate(-14deg) scale(1.08);
  }

  .ms-cta-blue {
    box-shadow: 0 14px 32px rgba(43, 87, 240, 0.5);
  }
  .ms-cta-blue:hover {
    transform: translateY(-3px);
    background: #4a72ff;
    box-shadow:
      0 20px 44px rgba(43, 87, 240, 0.6),
      0 0 0 1px rgba(122, 160, 255, 0.5);
  }

  .ms-cta-white {
    box-shadow: 0 10px 26px rgba(10, 16, 40, 0.14);
  }
  .ms-cta-white:hover {
    transform: translateY(-3px);
    background: #f0f3ff;
    box-shadow:
      0 20px 44px rgba(10, 16, 40, 0.28),
      0 0 0 1px rgba(255, 255, 255, 0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .ms-cta,
    .ms-cta:hover {
      transform: none;
    }
    .ms-cta::before {
      display: none;
    }
  }
</style>
