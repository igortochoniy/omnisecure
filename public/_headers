# Cloudflare Pages / Netlify honour this file.
# Security headers on every response. (No CSP here — it fights the CMS headCode
# injection, e.g. Google Analytics; add a tuned CSP per project if needed.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Hashed, fingerprinted build assets never change — cache them hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
